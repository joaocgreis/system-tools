# Detect text files automatically and normalize line endings to LF.
* text=auto eol=lf

# Explicit text formats
*.bat text eol=lf
*.cmd text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

